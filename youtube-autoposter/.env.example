APP_NAME="YouTube Auto-Poster"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://your-app.test
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=youtube_autoposter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3700

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- YouTube Auto-Poster -------------------------------------------------

AUTOPOSTER_ADMIN_EMAIL=you@example.com
# Optional JSON webhook for alerts (e.g. your WhatsApp command system)
AUTOPOSTER_WEBHOOK_URL=

# Google Cloud OAuth client (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"
# Flip to true once Google approves the YouTube API audit
YOUTUBE_AUDIT_PASSED=false

# Script writing (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
AUTOPOSTER_NICHE="personal finance in South Africa"
AUTOPOSTER_CHANNEL_VOICE="Plain-spoken, specific, a little dry. Explains like a smart friend, never hypes."

# Voiceover: elevenlabs | openai
AUTOPOSTER_TTS_DRIVER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy

# B-roll (free licence)
PEXELS_API_KEY=

# Rendering
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AUTOPOSTER_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Optional royalty-free music bed, path on the media disk (storage/app/private/...)
AUTOPOSTER_MUSIC_PATH=
AUTOPOSTER_MUSIC_VOLUME=0.08
